NODE_ENV=development
PORT=3001

# Where the frontend lives; password-reset emails link to $APP_URL/reset-password
APP_URL=http://localhost:5173

# Behind a reverse proxy: its IP(s), so uvicorn trusts X-Forwarded-For for rate limits
# FORWARDED_ALLOW_IPS=127.0.0.1

# Supabase — get these from Project Settings → API
SUPABASE_URL=https://bbwoasmiqxuasjokmrpe.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Email (Resend) — get from resend.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=                        # Resend API key
EMAIL_FROM=noreply@gradenture.pk

# Rate limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_SUBMISSIONS=5

# Gemini AI — get from aistudio.google.com
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
