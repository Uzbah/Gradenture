# Every variable here is declared in backend/core/conf.py. Adding one there means
# adding it here; the backend reads nothing from the environment that is not in
# that Settings class.

# --- Environment ---
ENVIRONMENT=dev          # dev | prod
PORT=3001

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Direct Postgres connection string (Project Settings -> Database).
# Used only by backend/scripts/migrate.py; the app itself goes through PostgREST.
DATABASE_URL=

# --- Redis ---
# Shared cache for the ban state, the Supabase JWKS document, and rate limits.
# Host is `redis` under docker compose, `localhost` when running the app directly.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# --- CORS ---
# JSON list. In production the backend serves the built SPA from the same origin,
# so this can stay empty there.
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_SUBMISSION=5/hour
RATE_LIMIT_FLAG=10/hour
# Leave empty for an in-process store (single worker only).
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0

# --- Email (Resend SMTP) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=                        # Resend API key
EMAIL_FROM=noreply@careerbridge.pk

# --- Resume analyzer (aistudio.google.com) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Logging ---
LOG_LEVEL=INFO
LOG_TO_FILE=false
